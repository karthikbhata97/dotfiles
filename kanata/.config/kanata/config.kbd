(defcfg
process-unmapped-keys yes
)

;; The external keyboard (2.4G Dongle) has Alt next to space and Win beside it,
;; so swap them there so the key next to space is Cmd on every keyboard.
;; Device ID 1 below is referenced by the device-history checks in the aliases.
;; Matched by USB IDs: kanata 1.12.0 keeps the quotes in (name "...") so it never matches.
(definputdevices
  1 ((vendor_id 0x0C45) (product_id 0xFDFD))
)

(defsrc
    esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
    grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]
    caps a    s    d    f    g    h    j    k    l    ;    '    \    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft
    lctl lalt lmet           spc            rmet ralt
)

(deflayer qwerty
    esc  🔅   🔆    ✗    ✗    ✗    ✗    ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
    grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]
    caps a    s    d    f    g    h    j    k    l    ;    '    \    ret
    lsft z    x    c    v    b    n    m    ,    .    @lay    rsft
    lctl @lalt @lmet           spc            @rmet @ralt
)

(deflayer homerowmod
    esc  🔅   🔆    ✗    ✗    ✗    ✗    ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
    grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  q    w    e    r    t    y    u    i    o    p    [    ]
    @arw @xlsft    @xlctl    @xlalt    @xlcmd    g    h    @xrcmd    @xralt    @xrctl    @xrsft    '    \    ret
    lsft z    x    c    v    b    n    m    ,    .    @lay    rsft
    lctl @lalt @lmet           spc            @rmet @ralt
)

(deflayer arrows
    esc  🔅   🔆    ✗    ✗    ✗    ✗    ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
    @home 1    2    3    4    5    6    7    8    9    0    -    =    bspc
    tab  @a1    @a2    @a3    @a4    @a5    y    u    i    o    p    [    ]
    caps a    s    d    pgdn    g    left    down    up    right    ;    '    \    ret
    lsft @a6    @a7    @a8    @a9    pgup    n    m    ,    .    /    rsft
    lctl @lalt @lmet           spc            @rmet @ralt
)

(deflayer layers
    esc  🔅   🔆    ✗    ✗    ✗    ✗    ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
    @home @hmod    2    3    4    5    6    7    8    9    0    -    =    bspc
    lrld  q    w    e    r    t    y    u    i    o    p    [    ]
    caps a    s    d    f    g    h    j    k    l    ;    '    \    ret
    lsft z    x    c    v    b    n    m    ,    .    /    rsft
    lctl @lalt @lmet           spc            @rmet @ralt
)

(defalias
home (tap-hold 200 200 grv (layer-switch qwerty))
lay  (tap-hold 1000 1000 / (layer-switch layers))
hmod  (tap-hold 200 200 1 (layer-switch homerowmod))
arw  (tap-hold 200 200 caps (layer-toggle arrows))
xlsft (tap-hold 300 300 a lsft)
xlctl (tap-hold 300 300 s lctl)
xlalt (tap-hold 300 300 d lalt)
xlcmd (tap-hold 300 300 f lmet)
xrcmd (tap-hold 300 300 j rmet)
xralt (tap-hold 300 300 k ralt)
xrctl (tap-hold 300 300 l rctl)
xrsft (tap-hold 300 300 ; rsft)
a1 M-A-f1
a2 M-A-f2
a3 M-A-f3
a4 M-A-f4
a5 M-A-f5
a6 M-A-f6
a7 M-A-f7
a8 M-A-f8
a9 M-A-f9
lalt (switch ((device-history 1 1)) lmet break () lalt break)
lmet (switch ((device-history 1 1)) lalt break () lmet break)
ralt (switch ((device-history 1 1)) rmet break () ralt break)
rmet (switch ((device-history 1 1)) ralt break () rmet break)
)
